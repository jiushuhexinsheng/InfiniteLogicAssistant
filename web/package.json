{
  "name": "infinite-logic-voice-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "verify:voice": "node scripts/verify-voice.mjs",
    "gen:api": "python ../scripts/gen_openapi.py && openapi-typescript src/api/openapi.json -o src/api/generated.ts",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.0.0"
  }
}
