# 无限逻辑·语音助手 — 配置（非敏感部分）
# 密钥一律不写在这里！请填到 config.secrets.yaml（或环境变量 LLM_API_KEY / ASR_API_KEY / TTS_API_KEY / SERVER_API_TOKEN）。
#
# 多厂商配置：建议在设置页「设置 → 新增 Profile」从内置厂商目录选择（自动预填 endpoint/model/音色），
# 本文件仅手填兜底。profile 字段说明：
#   provider    : 协议 openai（OpenAI 兼容）/ anthropic（Claude 原生）/ gemini（Gemini 原生）
#   vendor      : 厂商目录 ID（UI 元数据，来自 core/providers.py 或下方 vendor_presets）
#   api_key_env : 本 profile 专用环境变量名（优先级最高，如 DEEPSEEK_API_KEY）
#   models      : 可用模型列表（设置页「获取模型」自动拉取，也可手写）
#   compat      : 兼容开关 {stream_options: true/false, max_tokens_field: max_tokens|max_completion_tokens}

llm:
  # 当前生效的 LLM profile 名（对应 profiles 下的键名）；改 active 切换服务商
  active: deepseek
  profiles:
    deepseek:                 # OpenAI 兼容（示例，endpoint 为基座不含 /v1，与 chat_path 配对）
      provider: openai
      vendor: deepseek
      endpoint: "https://api.deepseek.com"
      model: "deepseek-chat"
      models: ["deepseek-chat", "deepseek-reasoner"]
      api_key_env: "DEEPSEEK_API_KEY"
      chat_path: "/v1/chat/completions"
      max_tokens: 4096
      temperature: 0.7
      timeout: 60
    openai:                   # OpenAI 官方
      provider: openai
      endpoint: "https://api.openai.com"
      model: "gpt-4o-mini"
      chat_path: "/v1/chat/completions"
      max_tokens: 4096
      temperature: 0.7
      timeout: 60
    qwen:                     # 通义千问（DashScope 兼容模式）
      provider: openai
      endpoint: "https://dashscope.aliyuncs.com/compatible-mode/v1"
      model: "qwen-plus"
      chat_path: "/chat/completions"
      max_tokens: 4096
      temperature: 0.7
      timeout: 60
    anthropic:                # Claude 原生协议（P2）
      provider: anthropic
      endpoint: "https://api.anthropic.com"
      model: "claude-sonnet-4-20250514"
      chat_path: "/v1/messages"
      max_tokens: 4096

voice:
  # 离线语音唤醒（浏览器端 Vosk WASM，关键词可任意改）
  wake_word:
    enabled: true
    keyword: "小逻小逻"
    sensitivity: 0.5
    model_path: "/models/vosk-model-small-cn-0.22.tar.gz"  # 浏览器端 URL
  # 静音检测（自动停止录音）
  vad:
    silence_threshold: 0.02
    silence_duration_ms: 1500
    max_duration_ms: 10000
  # 在线 ASR 语音转文字（OpenAI 兼容；endpoint/model 需自填，密钥在 config.secrets.yaml）
  asr:
    active: openai
    profiles:
      openai:
        provider: openai
        endpoint: ""                    # 例: https://api.siliconflow.cn/v1
        model: ""                       # 例: Qwen2-Audio-7B-Instruct（按服务商文档填写）
        language: "zh"
        timeout: 30
        chat_path: "/v1/chat/completions"
  # TTS（可选；另有浏览器端 SpeechSynthesis 播报，默认关闭）
  # 小米 MiMo 预置音色示例：model=mimo-v2.5-tts，voice 填内置音色名（mimo_default/冰糖/茉莉/苏打/白桦/Mia/Chloe/Milo/Dean）
  # voiceclone 模型（mimo-v2.5-tts-voiceclone）则需额外配置 voice_ref 参考音频
  tts:
    enabled: false
    profiles:
      openai:
        provider: xiaomi
        endpoint: "https://api.xiaomimimo.com"   # 或 OpenAI 兼容 TTS 端点
        model: "mimo-v2.5-tts"
        voice: "Chloe"                  # 内置音色名；留空默认 mimo_default
        format: "wav"                   # 输出格式: wav / mp3 / pcm16
        timeout: 30
        chat_path: "/v1/chat/completions"

server:
  host: "127.0.0.1"
  port: 8520
  open_browser: true
  # api_token 已移到 config.secrets.yaml（非 localhost 绑定时的 API 访问令牌）
  # 允许跨域的前端来源（默认空 = 禁止跨域；本地同源/开发代理不需要 CORS）
  cors_origins: []

# MCP server 列表：服务启动时自动连接并注册其工具（/api/tools 可见）
mcp:
  servers: []   # 例: [{name: echo, command: py, args: ["-3.14", "scripts/mcp_echo_server.py"]}]

# RAG 索引：启动时 index.db 缺失或源文件更新则自动重建；false 关闭自动构建
rag:
  auto_index: true

# 任务执行：ReAct 步数上限 / 复杂任务是否转多智能体协调者（可开关）
# models_failover：LLM 主模型故障（不存在/重试耗尽）时依次尝试的备选模型（openclaw 式 failover）
# structured_temperature：意图/任务形成/拆解/事实提取等结构化输出阶段的温度（默认 0.2，调低提稳）
agent:
  recursion_limit: 12
  multi_agent: false
  models_failover: []          # 例: ["gpt-4o-mini", "qwen-turbo"]
  structured_temperature: 0.2

# LLM 客户端：重试 / 熔断 / 连接池
llm_client:
  retry_max: 3
  retry_backoff_base: 0.5
  retry_backoff_max: 10.0
  circuit_breaker_threshold: 5
  circuit_breaker_cooldown: 30.0
  request_timeout: 60

# 工具参数
tools:
  search_max_results: 5

# 工具权限策略：工具调用是否需要操作者确认（可在设置页「权限」调整）
#   allow 直接执行 / ask 询问操作者 / deny 拒绝执行
# 求值顺序：未注册工具→拒绝 > 任一 deny 规则短路（不可被后续规则翻案）
#           > 首条匹配规则 > 层级默认 > default_action
# Tool permission policy: whether a tool call needs operator confirmation
#   (adjustable in the settings page).
#   allow runs directly / ask prompts / deny refuses.
# Order: unregistered→deny > any deny rule (monotonic) > first matching rule
#        > tier default > default_action.
permissions:
  default_action: ask          # 未命中任何规则时的兜底
  tiers:
    read: allow                # 只读工具免询问（与改造前行为一致）
    write: ask
    exec: ask
  rules: []                    # 形如 - {match: "web_search", action: allow}

# 厂商目录扩展（可选）：追加/覆盖 core/providers.py 内置预设，设置页「新增 Profile」可见。
# 同 ID 覆盖内置；endpoint 为基座不含 /v1，chat_path 与基座配对。
# vendor_presets:
#   my-gateway:
#     kind: llm                 # llm / asr / tts
#     label: 我的网关
#     provider: openai          # 协议
#     endpoint: "https://gateway.example.com"
#     chat_path: "/v1/chat/completions"
#     models: ["m1", "m2"]
#     api_key_env: "MY_GATEWAY_KEY"
#     compat: { stream_options: false }
