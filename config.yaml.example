# 无限逻辑·语音助手 — 配置（非敏感部分）
# 密钥一律不写在这里！请填到 config.secrets.yaml（或环境变量 LLM_API_KEY / ASR_API_KEY / TTS_API_KEY / SERVER_API_TOKEN）。
#
# 多厂商配置：建议在设置页「设置 → 新增 Profile」从内置厂商目录选择（自动预填 endpoint/model/音色），
# 本文件仅手填兜底。profile 字段说明：
#   provider    : 协议 openai（OpenAI 兼容）/ anthropic（Claude 原生）/ gemini（Gemini 原生）
#   vendor      : 厂商目录 ID（UI 元数据，来自 core/vendors.py 或下方 vendor_presets）
#   api_key_env : 本 profile 专用环境变量名（优先级最高，如 DEEPSEEK_API_KEY）
#   models      : 可用模型列表（设置页「获取模型」自动拉取，也可手写）
#   compat      : 兼容开关 {stream_options: true/false, max_tokens_field: max_tokens|max_completion_tokens}

llm:
  # 当前生效的 LLM profile 名（对应 profiles 下的键名）；改 active 切换服务商
  active: deepseek
  profiles:
    deepseek:                 # OpenAI 兼容（示例，endpoint 为基座不含 /v1，与 chat_path 配对）
      provider: openai
      vendor: deepseek
      endpoint: "https://api.deepseek.com"
      model: "deepseek-chat"
      models: ["deepseek-chat", "deepseek-reasoner"]
      api_key_env: "DEEPSEEK_API_KEY"
      chat_path: "/v1/chat/completions"
      max_tokens: 4096
      temperature: 0.7
      timeout: 60
    openai:                   # OpenAI 官方
      provider: openai
      endpoint: "https://api.openai.com"
      model: "gpt-4o-mini"
      chat_path: "/v1/chat/completions"
      max_tokens: 4096
      temperature: 0.7
      timeout: 60
    qwen:                     # 通义千问（DashScope 兼容模式）
      provider: openai
      endpoint: "https://dashscope.aliyuncs.com/compatible-mode/v1"
      model: "qwen-plus"
      chat_path: "/chat/completions"
      max_tokens: 4096
      temperature: 0.7
      timeout: 60
    anthropic:                # Claude 原生协议（P2）
      provider: anthropic
      endpoint: "https://api.anthropic.com"
      model: "claude-sonnet-4-20250514"
      chat_path: "/v1/messages"
      max_tokens: 4096

voice:
  # 语音唤醒（VAD → 本地 KWS 唤醒判定 → ASR 抬指令）
  # keywords 支持**多个**唤醒词，说哪个都能唤醒（命中任意一个即可）；旧写法 `keyword: 词`
  # 仍兼容（会当成唯一的那个唤醒词）。
  # ⚠️ 隐私边界：唤醒判定默认在本机完成（下方 kws 段，sherpa-onnx）——没说唤醒词的音频
  # 在本机直接丢弃、不上云；只有命中唤醒词的那段才上传云端 ASR 抬取指令文本。
  # （kws.enabled: false 或检测模型缺失时闸门旁路，才回到「每次人声段都上云」。）
  wake_word:
    enabled: true
    keywords:
      - 衍衡
      - 洛吉斯
    sensitivity: 0.5
    # Vosk 时代遗留字段（浏览器端 WASM 模型 URL）：唤醒改走 KWS/云端后已无人读，留空即可；
    # 字段本身保留只为不破坏已有配置（配置模型是 extra="forbid"，删字段会让老配置启动即报错）。
    model_path: ""
  # 本地 KWS 前置闸门（sherpa-onnx 关键词检测，仅配置文件可改）：云端 ASR 之前先在本机
  # 判定有没有唤醒词，未命中直接丢弃。模型目录缺失时闸门自动旁路并在启动日志注明。
  kws:
    enabled: true
    model_dir: "models/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01"
    keywords_threshold: 0.25    # 检测阈值：越低越灵敏（漏报少、误报多）
    keywords_score: 1.0         # 关键词得分加成：越高越易命中
  # 静音检测（自动停止录音）
  vad:
    silence_threshold: 0.02
    silence_duration_ms: 1500
    max_duration_ms: 10000
    # 短于此长度的片段直接丢弃、不上传（滤掉咳嗽/关门等爆音）：省调用量的第一道闸。
    # Clips shorter than this are dropped, never uploaded (filters coughs, door slams and
    # other transients): the first cost gate.
    min_speech_ms: 300
    # 两次「唤醒判定」上传之间的最小间隔（毫秒）：只节流唤醒判定路径，作答/指令通道不受影响。
    # Minimum gap (ms) between two wake-detection uploads; only that path is throttled, the
    # answer/command channels are not.
    upload_throttle_ms: 500
    # 裸唤醒后的等指令窗（毫秒）：只喊唤醒词不带指令，窗内没说指令则作废。
    # 回答本身永不限时（键名保持 answer_timeout_ms 兼容旧配置）。
    # Post-bare-wake command window (ms): with only the wake word spoken, an instruction
    # not arriving inside the window voids it. Answers themselves are never timed out
    # (key name kept answer_timeout_ms for old-config compatibility).
    answer_timeout_ms: 8000
    # 打断播报：true=助手说话时可用语音直接打断（独立回声消除流做能量检测）。
    # false（默认）= 播报期间停麦的旧行为。
    # Barge-in: true = speech can cut playback while the assistant talks (a separate
    # echo-cancelled stream does energy detection). false (default) = legacy mic-off.
    barge_in: false
    # 续聊窗口（毫秒）：回合结束/播报完后的免唤醒窗口，窗口内直接说话即当新指令；
    # 0=关闭（回到「结束后 3s 回聆听、必须喊唤醒词」的旧行为）。
    # Follow-up window (ms): wake-free window after a turn ends / playback finishes —
    # speak inside it and the words are taken as a fresh instruction; 0 = off.
    followup_window_ms: 6000
  # 通话模式（双击悬浮球进入，免唤醒持续聆听）：段落过三级漏斗
  # L0 规则 → L1 本地转写 → L2 云端精判，详见 docs/superpowers/specs/2026-10-05-call-mode-funnel-design.md
  call:
    enabled: true
    open_window_s: 8        # 回答后免焦点追问窗口（秒）；0 关闭
    l0_min_rms: 0.02        # 段落能量低于此视为非人声（实现期可用真音频标定）
    l0_min_seconds: 0.5     # 短于此的段本机丢弃
    smart_turn_enabled: true
    local_asr_model: "models/sherpa-onnx-streaming-zipformer-bilingual-zh-en-2023-02-20"
    merge_l2: true           # L2 合并调用：单次云端同时转写+四分类（省一次上传与一轮 LLM）；false = 两步旧路径
    session_ttl_s: 300       # 会话无段落自动过期（秒，防会话泄漏）
    relax_after_misses: 2    # 开放窗口内连续 miss 数，达到后 L2 复判放宽
  # 在线 ASR 语音转文字（OpenAI 兼容；endpoint/model 需自填，密钥在 config.secrets.yaml）
  asr:
    active: openai
    profiles:
      openai:
        provider: openai
        endpoint: ""                    # 例: https://api.siliconflow.cn/v1
        model: ""                       # 例: Qwen2-Audio-7B-Instruct（按服务商文档填写）
        language: "zh"
        timeout: 30
        chat_path: "/v1/chat/completions"
  # TTS（可选；另有浏览器端 SpeechSynthesis 播报，默认关闭）
  # 小米 MiMo 预置音色示例：model=mimo-v2.5-tts，voice 填内置音色名（mimo_default/冰糖/茉莉/苏打/白桦/Mia/Chloe/Milo/Dean）
  # voiceclone 模型（mimo-v2.5-tts-voiceclone）则需额外配置 voice_ref 参考音频
  tts:
    enabled: false
    profiles:
      openai:
        provider: xiaomi
        endpoint: "https://api.xiaomimimo.com"   # 或 OpenAI 兼容 TTS 端点
        model: "mimo-v2.5-tts"
        voice: "Chloe"                  # 内置音色名；留空默认 mimo_default
        format: "wav"                   # 输出格式: wav / mp3 / pcm16
        timeout: 30
        chat_path: "/v1/chat/completions"

server:
  host: "127.0.0.1"
  port: 8520
  open_browser: true
  # SSE 断线宽限（秒）：断开后任务继续跑，期内可 /voice/resume 续播；0=断线即停（旧行为）。
  # SSE disconnect grace (seconds): after a disconnect the task keeps running and can
  # resume via /voice/resume inside the window; 0 = stop on disconnect (legacy).
  resume_grace_s: 120
  # SSE 空闲保活 ping 间隔（秒）；前端看门狗 35s 必须大于此值
  ping_interval_s: 15
  # 会话空闲回收（秒）；SSE resume 缓冲事件数（ring buffer 容量）
  session_ttl_s: 1800
  sse_buffer_events: 500
  # api_token 已移到 config.secrets.yaml（非 localhost 绑定时的 API 访问令牌）
  # 允许跨域的前端来源（默认空 = 禁止跨域；本地同源/开发代理不需要 CORS）
  cors_origins: []

# MCP server 列表：服务启动时自动连接并注册其工具（/api/tools 可见）
mcp:
  servers: []   # 例: [{name: echo, command: py, args: ["-3.14", "scripts/mcp_echo_server.py"]}]

# RAG 索引：启动时 index.db 缺失或源文件更新则自动重建；false 关闭自动构建
rag:
  auto_index: true
  # 精排（docs/designs/05）：none=纯 BM25（默认零成本）；llm=粗排候选后单次 LLM 打分，
  # 失败自动回退 BM25 序并记审计。
  rerank: none               # none | llm
  rerank_candidates: 12      # 粗排候选数（rerank=llm 时先取这么多）
  rerank_top_k: 5            # 最终注入条数
  cache_ttl_s: 300           # 检索/精排结果缓存保鲜期（秒）
  cache_max_entries: 128     # 缓存容量上限（按插入序淘汰最旧）

# 长期记忆（docs/designs/04）：检索新近度加权 + 注入预算 + 提取回看深度
# recency_weight=0 关闭加权（纯 bm25）；inject_* 双闸限制注入 system prompt 的记忆体量
memory:
  recency_half_life_days: 30   # 新近度半衰期（天）
  recency_weight: 0.5          # 加权强度（0=关）
  inject_top_k: 5              # 注入条数上限
  inject_max_chars: 800        # 注入字符预算
  extract_recent_messages: 2   # 任务后提取回看的最近对话条数（用户/助手各 N）

# 任务执行：ReAct 步数上限 / 复杂任务是否转多智能体协调者（可开关）
# models_failover：LLM 主模型故障（不存在/重试耗尽）时依次尝试的备选模型（openclaw 式 failover）
# structured_temperature：意图/任务形成/拆解/事实提取等结构化输出阶段的温度（默认 0.2，调低提稳）
# auto_approve：true=write/exec 高风险工具/任务自动放行、不再询问操作者（含子代理与技能；无通道无人值守仍拒绝）
# confirm_timeout_s：操作者提问（澄清/确认）超时秒数，0=不限（无限期等待）；到期按拒绝处理（fail-closed）
# condense_threshold_chars：ReAct 历史滚动压缩阈值（字符），超阈值折叠中间段；0=关闭
agent:
  recursion_limit: 12
  multi_agent: false
  models_failover: []          # 例: ["gpt-4o-mini", "qwen-turbo"]
  structured_temperature: 0.2
  auto_approve: false
  confirm_timeout_s: 0
  condense_threshold_chars: 12000
  max_concurrent_subagents: 4   # 多智能体子代理并发上限

# LLM 客户端：重试 / 熔断 / 连接池
llm_client:
  retry_max: 3
  retry_backoff_base: 0.5
  retry_backoff_max: 10.0
  circuit_breaker_threshold: 5
  circuit_breaker_cooldown: 30.0
  request_timeout: 60

# 工具参数
tools:
  search_max_results: 5
  # LLM 口径输出截断（docs/designs/08）：喂给模型的 tool 正文上限，0=不限；
  # 展示（SSE 预览 500）与落库（4000）口径独立不受影响。
  llm_max_output_chars: 8000
  # 渐进式工具 schema（docs/designs/08）：这些分组降级为一行简介（完整参数先调
  # tools_describe）；默认 []=全量下发。例: ["mcp"]（挂多个 MCP server 时首轮 prompt 瘦身）。
  lazy_groups: []

# 工具权限策略：工具调用是否需要操作者确认（可在设置页「权限」调整）
#   allow 直接执行 / ask 询问操作者 / deny 拒绝执行
# 求值顺序：未注册工具→拒绝 > 任一 deny 规则短路（不可被后续规则翻案）
#           > 首条匹配规则 > 层级默认 > default_action
# Tool permission policy: whether a tool call needs operator confirmation
#   (adjustable in the settings page).
#   allow runs directly / ask prompts / deny refuses.
# Order: unregistered→deny > any deny rule (monotonic) > first matching rule
#        > tier default > default_action.
permissions:
  default_action: allow        # 未命中任何规则时的兜底（默认也放行）
  tiers:
    read: allow                # 三档默认全放行（2026-09-13，与 schema 默认一致）；改 ask 恢复询问
    write: allow
    exec: allow
  rules: []                    # 形如 - {match: "run_*", action: deny}；deny 单调短路、不可翻案

# 厂商目录扩展（可选）：追加/覆盖 core/vendors.py 内置预设，设置页「新增 Profile」可见。
# 同 ID 覆盖内置；endpoint 为基座不含 /v1，chat_path 与基座配对。
# vendor_presets:
#   my-gateway:
#     kind: llm                 # llm / asr / tts
#     label: 我的网关
#     provider: openai          # 协议
#     endpoint: "https://gateway.example.com"
#     chat_path: "/v1/chat/completions"
#     models: ["m1", "m2"]
#     api_key_env: "MY_GATEWAY_KEY"
#     compat: { stream_options: false }
