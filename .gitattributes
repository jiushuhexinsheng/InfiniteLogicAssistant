# Windows 批处理：cmd 解析 LF + 括号块会损坏 %~dp0/变量，必须保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 模型大文件走 Git LFS（GitHub 单文件 100MB 硬限）。
# Large model files go through Git LFS (GitHub's 100MB per-file limit).
models/**/*.onnx filter=lfs diff=lfs merge=lfs -text
models/**/*.bin  filter=lfs diff=lfs merge=lfs -text
