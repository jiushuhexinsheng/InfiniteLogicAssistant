# 密钥独立存储 —— 本文件不入仓库（gitignored），只提交此模板。
# 复制为 config.secrets.yaml 填入实际值；环境变量 LLM_API_KEY / ASR_API_KEY / TTS_API_KEY /
# SERVER_API_TOKEN 优先级更高（设置了环境变量则忽略此处同段值）。
#
# config.yaml 里不再写任何 api_key；密钥统一走这里 + 环境变量。

llm:
  api_key: ""            # 所有 LLM profile 的默认密钥
  # 需要不同服务商不同密钥时，按 profile 单独设置（优先级高于段默认）：
  # profiles:
  #   deepseek: "sk-..."
  #   openai: "sk-..."
  #   qwen: "sk-..."

asr:
  api_key: ""

tts:
  api_key: ""

server:
  api_token: ""          # 非 localhost 绑定时的 API 访问令牌（留空则禁止非 localhost 绑定）
